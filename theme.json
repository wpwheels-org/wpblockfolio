{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "WPBlockfolio",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"name": "Deep Emerald",
					"color": "#1f6f56"
				},
				{
					"slug": "primary-dark",
					"name": "Deep Emerald Dark",
					"color": "#164f3e"
				},
				{
					"slug": "primary-light",
					"name": "Emerald Light",
					"color": "#34a17f"
				},
				{
					"slug": "accent",
					"name": "Warm Amber",
					"color": "#e0973a"
				},
				{
					"slug": "accent-dark",
					"name": "Warm Amber Dark",
					"color": "#c07b24"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#181a17"
				},
				{
					"slug": "body-text",
					"name": "Body Text",
					"color": "#5c6259"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#f6f4ee"
				},
				{
					"slug": "surface-alt",
					"name": "Surface Alt",
					"color": "#ece8dc"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#e2ddcd"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"slug": "primary-gradient",
					"name": "Emerald Gradient",
					"gradient": "linear-gradient(135deg,#1f6f56 0%,#34a17f 100%)"
				},
				{
					"slug": "accent-gradient",
					"name": "Amber Gradient",
					"gradient": "linear-gradient(135deg,#e0973a 0%,#f0b565 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Poppins",
					"fontFamily": "\"Poppins\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins/poppins-v24-latin-500.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins/poppins-v24-latin-600.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins/poppins-v24-latin-700.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins/poppins-v24-latin-800.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-v20-latin-regular.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-v20-latin-500.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-v20-latin-600.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-v20-latin-700.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem"
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "1.75rem"
				},
				{
					"slug": "xx-large",
					"name": "XX-Large",
					"size": "2.5rem"
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "3.25rem"
				}
			]
		},
		"spacing": {
			"customMargin": true,
			"customPadding": true,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "4rem"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "6rem"
				}
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		},
		"custom": {
			"radius": {
				"small": "8px",
				"medium": "14px",
				"large": "20px",
				"pill": "999px"
			},
			"shadow": {
				"card": "0 10px 40px rgba(24,26,46,0.06)",
				"card-hover": "0 20px 50px rgba(24,26,46,0.12)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#181a17"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "1.25rem",
				"right": "1.25rem"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"color": {
					"text": "#181a17"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "0.95rem"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"width": "2px",
							"color": "var(--wp--preset--color--ink)"
						},
						"color": {
							"text": "var(--wp--preset--color--ink)",
							"background": "transparent"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "front-page",
			"title": "Front Page (Portfolio One-Page)"
		},
		{
			"name": "page-no-title",
			"title": "Page (No Title)"
		}
	]
}