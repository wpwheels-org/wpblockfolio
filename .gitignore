# Vendor + dependency files
node_modules/
vendor/

# Enviroment
.env
.wp-env.override.json

# Local configs
phpcs.xml
phpunit.xml
phpstan.neon

# Log files
*.log
/tests/logs

# Lint / analysis caches
.phpcs-cache.json

# Test output
/tests/_output/*
!/tests/_output/.gitkeep

# OS files
[Tt]humbs.db
[Dd]esktop.ini
*.DS_store
.DS_store?

# IDE files
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.code-workspace

# Build
# Only the top-level Grunt release artifact is ignored. assets/build/ is
# webpack output that the theme loads at runtime (functions.php enqueues
# assets/build/css/custom.css and assets/build/js/main.js), so it is tracked.
/build/

# Source maps are never committed, but the built assets themselves are.
assets/build/**/*.map
