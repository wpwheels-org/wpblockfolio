{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Noir",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "name": "Charcoal", "color": "#1a1a1a" },
				{ "slug": "primary-dark", "name": "Black", "color": "#000000" },
				{ "slug": "primary-light", "name": "Graphite", "color": "#4d4d4d" },
				{ "slug": "accent", "name": "Brass", "color": "#9a8c66" },
				{ "slug": "accent-dark", "name": "Brass Dark", "color": "#7c7050" },
				{ "slug": "ink", "name": "Ink", "color": "#111111" },
				{ "slug": "body-text", "name": "Body Text", "color": "#565656" },
				{ "slug": "surface", "name": "Surface", "color": "#f5f5f4" },
				{ "slug": "surface-alt", "name": "Surface Alt", "color": "#eaeae8" },
				{ "slug": "border", "name": "Border", "color": "#e0dfdc" },
				{ "slug": "white", "name": "White", "color": "#ffffff" }
			],
			"gradients": [
				{
					"slug": "primary-gradient",
					"name": "Charcoal Gradient",
					"gradient": "linear-gradient(135deg,#1a1a1a 0%,#4d4d4d 100%)"
				},
				{
					"slug": "accent-gradient",
					"name": "Brass Gradient",
					"gradient": "linear-gradient(135deg,#9a8c66 0%,#c4b58c 100%)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#111111"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "#111111"
				}
			}
		}
	}
}
