<?xml version="1.0"?>
<ruleset
	name="WPCS for Theme/Plugin"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd"
>
	<description>Sniffs for theme/plugin</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude paths -->
	<exclude-pattern>**/build/**</exclude-pattern>
	<exclude-pattern>**/node_modules/**</exclude-pattern>
	<exclude-pattern>**/vendor/**</exclude-pattern>
	<exclude-pattern>**/vendor-prefixed/**</exclude-pattern>
	<exclude-pattern>**/tests/**</exclude-pattern>
	<!-- Third-party TGM Plugin Activation library - not our code to fix. -->
	<exclude-pattern>**/inc/tgm/**</exclude-pattern>

	<!-- CLI args -->
	<arg value="sp" />
	<arg name="basepath" value="./" />
	<arg name="colors" />
	<arg name="extensions" value="php" />
	<arg name="cache" value=".phpcs-cache.json" />
	<arg name="parallel" value="20" />
	<arg name="severity" value="1" />

	<!--
		PHP version compatibility: matches the "Requires PHP: 7.4" declared in
		style.css / readme.txt, so PHP 8-only syntax is reported. composer.json
		requires ^8.0 only because the dev toolchain needs it.
	-->
	<config name="testVersion" value="7.4-" />

	<!-- WordPress version compatibility: correct WPCS config key -->
	<config name="minimum_supported_wp_version" value="6.4" />

	<!--
		WordPress VIP Go standards
		@see: https://docs.wpvip.com/technical-references/vip-code-analysis-bot/phpcs-report/
	-->
	<rule ref="WordPress-VIP-Go">
		<exclude name="WordPressVIPMinimum.JS" />
	</rule>

	<!--
		PHPCompatibility + PHPCompatibilityWP
		@see: https://github.com/PHPCompatibility/PHPCompatibilityWP
	-->
	<rule ref="PHPCompatibilityWP" />

	<!--
		Core WordPress Coding Standards
		@see: https://github.com/WordPress/WordPress-Coding-Standards
	-->
	<rule ref="WordPress-Extra">
		<exclude name="Generic.Commenting.DocComment.MissingShort" />
		<exclude name="Universal.Arrays.DisallowShortArraySyntax" />
		<exclude name="Universal.Operators.DisallowShortTernary" />
		<exclude name="WordPress.Files.FileName" />
		<!-- Deprecated in PHPCS v4 -->
		<exclude name="Generic.Functions.CallTimePassByReference" />
	</rule>
	<rule ref="WordPress-Docs">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>

	<!-- Enforce short array syntax [] over array() -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax" />

	<!--
		Test-specific exclusions
	-->
	<rule ref="Generic.Files.OneObjectStructurePerFile.MultipleFound">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="Generic.PHP.NoSilencedErrors">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.EnqueuedResources.NonEnqueuedScript">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Files.IncludingFile.UsingVariable">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>**/tests/**</exclude-pattern>
	</rule>

	<!--
		Plugin-specific customizations
	-->

	<!-- Enforce plugin prefix on all globals -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>**/tests/**</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="WPBLOCKFOLIO" /><!-- Constants -->
				<element value="WPBlockfolio" /><!-- Classes -->
				<element value="wpblockfolio_" /><!-- Functions/variables -->
			</property>
		</properties>
	</rule>

	<!-- Enforce text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wpblockfolio" />
			</property>
		</properties>
	</rule>

	<!--
		Theme helpers that return already-escaped markup, so echoing their
		return value needs no further escaping:
		- wpblockfolio_marquee_track() escapes each filename/label itself.
		- wpblockfolio_get_contact_form() returns either do_shortcode() output
		  (a Contact Form 7 form) or an esc_html()'d notice with an
		  esc_url()'d mailto link. Running it through wp_kses_post() would
		  strip the <form> markup and break the form.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="wpblockfolio_marquee_track" />
				<element value="wpblockfolio_get_contact_form" />
			</property>
		</properties>
	</rule>

	<!--
		Block pattern files open with a WordPress pattern header comment
		(Title:/Slug:/Categories:/...), which is a WordPress convention rather
		than a PHPDoc file comment, so @package does not apply.
	-->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>**/patterns/*.php</exclude-pattern>
	</rule>

	<!--
		WordPress action/filter callbacks must match the hook's signature. A
		filter that replaces a value outright (e.g. excerpt_length) is
		required by the API to accept the incoming parameter without using
		it, so this sniff is incompatible with the filter idiom.
	-->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<severity>0</severity>
	</rule>

</ruleset>
